# Copy this file to `.env` and fill in your key.
# DeepSeek 的 API 兼容 OpenAI SDK，便宜且对中文场景友好。
# Get one at https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=

# (可选) 飞书群机器人 webhook URL。配了就自动推 Top 5 到飞书群（手机也收得到）。
# 怎么拿: 在飞书群里点右上角"设置 → 群机器人 → 添加机器人 → 自定义机器人"，
#         拿到 webhook URL 填这里。
FEISHU_WEBHOOK_URL=

# (可选) 飞书开放平台自建应用机器人。能推到任何 chat / user / email，不绑群。
# 需要在飞书开放平台后台开启 im:message:send_as_bot 权限并发布生效。
# RECEIVE_ID_TYPE 取值: chat_id (默认) | open_id | email | user_id
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
