# Copy this file to `.env` and fill in your key.
# DeepSeek 的 API 兼容 OpenAI SDK，便宜且对中文场景友好。
# Get one at https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=

# Cloud/API security. If set, all /api/* endpoints require:
# Authorization: Bearer <API_TOKEN>
# Leave empty for local development.
API_TOKEN=

# Optional cloud path overrides. Useful when mounting a persistent disk.
SHOW_TRACE_DATA_DIR=
SHOW_TRACE_DB_PATH=
SHOW_TRACE_DIGEST_DIR=
SHOW_TRACE_RAW_DIR=
SHOW_TRACE_CONFIG_PATH=

# Optional comma-separated source names to disable at runtime.
# Example for stable-source-only cloud runs: damai
SHOW_TRACE_DISABLED_SOURCES=

# Render cron helper: public API base URL for scripts/trigger_cloud_run.py
# Local hard-source sync also uses these values.
SHOW_TRACE_API_BASE_URL=
SHOW_TRACE_CLOUD_API_TOKEN=
SHOW_TRACE_RUN_FIXTURE=false
SHOW_TRACE_RUN_NOTIFY=true

# (可选) 飞书群机器人 webhook URL。配了就自动推 Top 5 到飞书群（手机也收得到）。
# 怎么拿: 在飞书群里点右上角"设置 → 群机器人 → 添加机器人 → 自定义机器人"，
#         拿到 webhook URL 填这里。
FEISHU_WEBHOOK_URL=

# (可选) 飞书开放平台自建应用机器人。能推到任何 chat / user / email，不绑群。
# 需要在飞书开放平台后台开启 im:message:send_as_bot 权限并发布生效。
# RECEIVE_ID_TYPE 取值: chat_id (默认) | open_id | email | user_id
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
